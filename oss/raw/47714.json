    "localization": {
     "en": {
      "judul": "Perdagangan Eceran Tas, Dompet, Koper, Ransel, dan Sejenisnya",
      "uraian": "Kelompok ini mencakup perdagangan eceran khusus tas, dompet, koper, ransel, dan sejenisnya baik terbuat dari kulit, tiruan kulit, tekstil, plastik ,karet, dan bahan lainnya, seperti tas tangan, tas belanja, tas sekolah, tas surat, tas olahraga, dompet, kotak rias, sarung pedang/pisau, tempat kamera, tempat kaca mata, dan kotak pensil, termasuk perdagangan eceran payung."
     },
     "id": {
