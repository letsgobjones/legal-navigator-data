      "localization": {
       "en": {
        "uraian": "Bidang Usaha Angkutan Penyeberangan Perintis Antar Propinsi (kecuali usaha persewaan angkutan penyeberangan berikut operatornya) (kecuali Cabotage), terbuka untuk modal asing maksimal 60% bagi investor dari ASEAN, berdasarkan Perjanjian Internasional."
       },
       "id": {
