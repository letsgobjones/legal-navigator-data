     {
      "id": "972874bf-d497-4468-9910-d2aa36a49d3f",
      "localization": {
       "en": {
        "uraian": "<p>Seluruh Bidang Usaha dalam Ruang Lingkup Kegiatan KBLI ini, terbuka untuk modal asing maksimal 49%, sebagaimana diatur di dalam Peraturan Presiden No. 49 Tahun 2021 tentang Perubahan Atas Peraturan Presiden No. 10 Tahun 2021 tentang Bidang Usaha Penanaman Modal.</p>"
       },
       "id": {
        "uraian": "<p>Seluruh Bidang Usaha dalam Ruang Lingkup Kegiatan KBLI ini, terbuka untuk modal asing maksimal 49%, sebagaimana diatur di dalam Peraturan Presiden No. 49 Tahun 2021 tentang Perubahan Atas Peraturan Presiden No. 10 Tahun 2021 tentang Bidang Usaha Penanaman Modal.</p>"
       }
      }
     },
     {
      "id": "b492356d-71ea-4206-a753-3104f30a35ad",
      "localization": {
       "en": {
        "uraian": "Bidang Usaha Angkutan Sungai dan danau dengan Trayek Tidak Tetap dan Tidak Teratur Untuk Wisata (kecuali Cabotage), terbuka untuk modal asing maksimal 60% bagi investor dari ASEAN, berdasarkan Perjanjian Internasional."
       },
       "id": {
        "uraian": "Bidang Usaha Angkutan Sungai dan danau dengan Trayek Tidak Tetap dan Tidak Teratur Untuk Wisata (kecuali Cabotage), terbuka untuk modal asing maksimal 60% bagi investor dari ASEAN, berdasarkan Perjanjian Internasional."
       }
      }
     }
    ]
