    "localization": {
     "en": {
      "judul": "Konstruksi Bangunan Pelabuhan Perikanan",
      "uraian": "Kelompok ini mencakup kegiatan pembangunan, pemeliharaan, dan/atau pembangunan kembali bangunan dermaga (jetty), trestle, sarana pelabuhan, dan sejenisnya pelabuhan perikanan, termasuk konstruksi jalan air atau terusan, pelabuhan dan sarana jalur sungai, dok (pangkalan), lock (panama canal lock, hoover dam), dan lain-lain."
     },
     "id": {
      "judul": "Konstruksi Bangunan Pelabuhan Perikanan",
      "uraian": "Kelompok ini mencakup kegiatan pembangunan, pemeliharaan, dan/atau pembangunan kembali bangunan dermaga (jetty), trestle, sarana pelabuhan, dan sejenisnya pelabuhan perikanan, termasuk konstruksi jalan air atau terusan, pelabuhan dan sarana jalur sungai, dok (pangkalan), lock (panama canal lock, hoover dam), dan lain-lain."
