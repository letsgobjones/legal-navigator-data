   "Kbli": {
    "id": "ef380dbf-50ea-52ce-b2ee-8a9cc49c1101",
    "localization": {
     "en": {
      "judul": "Pengerjaan Lantai, Dinding, dan Plafon",
      "uraian": "Kelompok ini mencakup kegiatan pengerjaan lantai, dinding, dan plafon dalam rangka penyelesaian bangunan gedung hunian dan nonhunian serta bangunan sipil.\nKelompok ini mencakup\n- pelapisan interior atau eksterior dengan plester, stuko, termasuk bahan rangka pelapisan yang berkaitan;\n- penyelesaian interior seperti plafon (misalnya dari gipsum), penutup dinding dari kayu, partisi/sekat yang dapat dibongkar pasang;\n- pemasangan penutup lantai dan dinding dari keramik, beton, batu alam; pemasangan lantai parket, dan penutup lantai kayu lainnya; pemasangan linoleum, karpet, termasuk penutup lantai dari karet atau plastik; pemasangan lantai dan dinding dari teraso, marmer, granit, atau batu sabak; pemasangan kertas dinding/wallpaper atau pelapis dinding lainnya."
     },
     "id": {
      "judul": "Pengerjaan Lantai, Dinding, dan Plafon",
      "uraian": "Kelompok ini mencakup kegiatan pengerjaan lantai, dinding, dan plafon dalam rangka penyelesaian bangunan gedung hunian dan nonhunian serta bangunan sipil.\nKelompok ini mencakup\n- pelapisan interior atau eksterior dengan plester, stuko, termasuk bahan rangka pelapisan yang berkaitan;\n- penyelesaian interior seperti plafon (misalnya dari gipsum), penutup dinding dari kayu, partisi/sekat yang dapat dibongkar pasang;\n- pemasangan penutup lantai dan dinding dari keramik, beton, batu alam; pemasangan lantai parket, dan penutup lantai kayu lainnya; pemasangan linoleum, karpet, termasuk penutup lantai dari karet atau plastik; pemasangan lantai dan dinding dari teraso, marmer, granit, atau batu sabak; pemasangan kertas dinding/wallpaper atau pelapis dinding lainnya."
     }
    },
