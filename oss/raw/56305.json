   "Kbli": {
    "id": "b0287593-7582-539c-9880-21af0e63c00f",
    "localization": {
     "en": {
      "judul": "Aktivitas Rumah/Kedai Obat Bahan Alam",
      "uraian": "Kelompok ini mencakup jenis kegiatan yang bertempat di sebagian atau seluruh bangunan permanen yang menjual dan menyajikan minuman jamu atau obat bahan alam untuk umum di tempat usahanya, baik dilengkapi dengan peralatan/perlengkapan untuk proses pembuatan dan penyimpanan maupun tidak. Kelompok ini juga mencakup penyediaan jasa pelayanan minum yang menyajikan minuman jamu siap dikonsumsi yang melalui proses pembuatan di tempat tetap yang dapat dipindah-pindahkan atau dibongkar pasang, biasanya dengan menggunakan tenda, seperti kedai jamu."
     },
     "id": {
      "judul": "Aktivitas Rumah/Kedai Obat Bahan Alam",
      "uraian": "Kelompok ini mencakup jenis kegiatan yang bertempat di sebagian atau seluruh bangunan permanen yang menjual dan menyajikan minuman jamu atau obat bahan alam untuk umum di tempat usahanya, baik dilengkapi dengan peralatan/perlengkapan untuk proses pembuatan dan penyimpanan maupun tidak. Kelompok ini juga mencakup penyediaan jasa pelayanan minum yang menyajikan minuman jamu siap dikonsumsi yang melalui proses pembuatan di tempat tetap yang dapat dipindah-pindahkan atau dibongkar pasang, biasanya dengan menggunakan tenda, seperti kedai jamu."
     }
    },
