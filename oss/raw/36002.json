   "localization": {
    "en": {
     "uraian": "Kelompok ini mencakup usaha pengadaan dan penyaluran air (laut) baku yang memanfaatkan ruang laut secara menetap minimal 30 hari dengan atau tanpa pengolahan untuk keperluan industri, pembangkit listrik dan lain lain",
     "deskripsi": null
    },
    "id": {
     "uraian": "Kelompok ini mencakup usaha pengadaan dan penyaluran air (laut) baku yang memanfaatkan ruang laut secara menetap minimal 30 hari dengan atau tanpa pengolahan untuk keperluan industri, pembangkit listrik dan lain lain",
     "deskripsi": null
    }
