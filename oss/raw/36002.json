   "Kbli": {
    "id": "9ba1c01a-aa0c-56c8-a93c-3bf73609764c",
    "localization": {
     "en": {
      "judul": "Penampungan dan Penyediaan Air Baku",
      "uraian": "Kelompok ini mencakup kegiatan penyediaan air baku untuk keperluan industri, pembangkit listrik, dan lain-lain, termasuk yang dilakukan di dalam kawasan hutan. Kelompok ini juga mencakup kegiatan pengelolaan jaringan irigasi.\nKelompok ini tidak mencakup\n- penyediaan jasa irigasi seperti penyemprotan untuk keperluan pertanian;\n- penggunaan air baku sebagai media budi daya oleh pembudi daya ikan yang dilakukan sebagai satu rangkaian kegiatan."
     },
     "id": {
      "judul": "Penampungan dan Penyediaan Air Baku",
      "uraian": "Kelompok ini mencakup kegiatan penyediaan air baku untuk keperluan industri, pembangkit listrik, dan lain-lain, termasuk yang dilakukan di dalam kawasan hutan. Kelompok ini juga mencakup kegiatan pengelolaan jaringan irigasi.\nKelompok ini tidak mencakup\n- penyediaan jasa irigasi seperti penyemprotan untuk keperluan pertanian;\n- penggunaan air baku sebagai media budi daya oleh pembudi daya ikan yang dilakukan sebagai satu rangkaian kegiatan."
     }
