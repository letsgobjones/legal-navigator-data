    "localization": {
     "en": {
      "judul": "Pemasangan Saluran Air (Plumbing)",
      "uraian": "Kelompok ini mencakup kegiatan pemasangan, perbaikan, pemeliharaan saluran air bersih, air limbah dan drainase, peralatan saniter pada bangunan gedung hunian maupun nonhunian. Kelompok ini mencakup pemasangan saluran air, pipa distribusi air bersih dan instalasi water treatment plant (WTP) atau osmosis balik/reverse osmosis (RO), dan pipa air kotor."
     },
     "id": {
      "judul": "Pemasangan Saluran Air (Plumbing)",
      "uraian": "Kelompok ini mencakup kegiatan pemasangan, perbaikan, pemeliharaan saluran air bersih, air limbah dan drainase, peralatan saniter pada bangunan gedung hunian maupun nonhunian. Kelompok ini mencakup pemasangan saluran air, pipa distribusi air bersih dan instalasi water treatment plant (WTP) atau osmosis balik/reverse osmosis (RO), dan pipa air kotor."
