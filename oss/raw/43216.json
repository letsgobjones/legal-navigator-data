    "localization": {
     "en": {
      "judul": "Pemasangan Perlengkapan Jalan Berbasis Listrik",
      "uraian": "Kelompok ini mencakup kegiatan pemasangan, pemeliharaan, dan perbaikan perlengkapan jalan berbasis listrik, seperti lampu penerangan, rambu lalu lintas elektronik, dan alat pemberi isyarat lalu lintas. Kelompok ini tidak mencakup pemasangan perlengkapan jalan bukan berbasis listrik, lihat subgolongan 4390."
     },
     "id": {
