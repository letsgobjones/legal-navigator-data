    "id": "48ecd070-a47c-5abd-95a8-fc4e8c14eb0b",
    "localization": {
     "en": {
      "judul": "Perdagangan Eceran Sediaan Farmasi untuk Manusia di Apotek",
      "uraian": "Kelompok ini mencakup perdagangan eceran berbagai bentuk sediaan farmasi untuk manusia di apotek, misalnya dalam bentuk tablet, kapsul, salep, bubuk, larutan, larutan parenteral dan suspensi, seperti obat-obat untuk penyakit kulit, mata, gigi, telinga, saluran pernapasan, saluran pencernaan, darah tinggi, kelainan hormon dan vitamin-vitamin serta suplemen kesehatan, termasuk juga barang keperluan kesehatan dari karet, antara lain kondom, alat sedot susu ibu, dot susu, kantong darah, sarung tangan untuk pembedahan, pipet karet, alat keluarga berencana dan sumbat karet untuk botol kecil (vial) farmasi."
     },
     "id": {
      "judul": "Perdagangan Eceran Sediaan Farmasi untuk Manusia di Apotek",
      "uraian": "Kelompok ini mencakup perdagangan eceran berbagai bentuk sediaan farmasi untuk manusia di apotek, misalnya dalam bentuk tablet, kapsul, salep, bubuk, larutan, larutan parenteral dan suspensi, seperti obat-obat untuk penyakit kulit, mata, gigi, telinga, saluran pernapasan, saluran pencernaan, darah tinggi, kelainan hormon dan vitamin-vitamin serta suplemen kesehatan, termasuk juga barang keperluan kesehatan dari karet, antara lain kondom, alat sedot susu ibu, dot susu, kantong darah, sarung tangan untuk pembedahan, pipet karet, alat keluarga berencana dan sumbat karet untuk botol kecil (vial) farmasi."
     }
